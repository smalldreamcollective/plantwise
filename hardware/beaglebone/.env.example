# BeagleBone Black environment config
# Copy to ~/.plantwise.env and fill in your values
#
# WARNING: systemd EnvironmentFile does not support inline comments.
# Do NOT add # comments after values — put comments on their own lines only.

# Device identity
DEVICE_ID=living-room
PLANT_ID=1
SENSOR_INTERVAL_S=900

# MQTT broker (Mac LAN IP)
MQTT_HOST=192.168.1.x
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# InfluxDB (Mac LAN IP — same host as MQTT broker)
INFLUXDB_URL=http://192.168.1.x:8086
INFLUXDB_TOKEN=plantwise-dev-token
INFLUXDB_ORG=plantwise
INFLUXDB_BUCKET=sensors

# Store-and-forward buffer path
BUFFER_DB_PATH=/home/debian/.plantwise_buffer.db
