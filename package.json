{
  "name": "plantwise",
  "version": "0.1.0",
  "description": "AI-powered houseplant care assistant",
  "main": "dist/cli/index.js",
  "bin": {
    "plantwise": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "add": "tsx src/cli/index.ts add",
    "update": "tsx src/cli/index.ts update",
    "log": "tsx src/cli/index.ts log",
    "sensor": "tsx src/cli/index.ts sensor",
    "device": "tsx src/cli/index.ts device",
    "channel": "tsx src/cli/index.ts channel",
    "remind": "tsx src/cli/index.ts remind",
    "remove": "tsx src/cli/index.ts remove",
    "status": "tsx src/cli/index.ts status",
    "identify": "tsx src/cli/index.ts identify",
    "diagnose": "tsx src/cli/index.ts diagnose",
    "serve": "tsx src/cli/index.ts serve",
    "help": "tsx src/cli/index.ts help-guide",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "start-work": "bash scripts/start-work.sh",
    "issue": "gh issue list",
    "issue:new": "gh issue create",
    "issue:view": "gh issue view"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@langchain/anthropic": "^1.3.21",
    "@langchain/core": "^1.1.29",
    "@langchain/langgraph": "^1.0.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "commander": "^13.0.0",
    "dotenv": "^16.4.7",
    "mqtt": "^5.15.0",
    "sharp": "^0.33.5",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
