ANTHROPIC_API_KEY=
PLANTID_API_KEY=
DB_PATH=./plantwise.db

# MQTT (required for `npm run serve`)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_NOTIFY=false
TARGET_VERSION=   # expected BBB package version — if set, subscriber warns when a device reports a different version

# InfluxDB (Phase 4F — populated automatically by Docker Compose on first run)
INFLUXDB_URL=http://localhost:8086          # External URL — used by BBB publisher and browser
INFLUXDB_INTERNAL_URL=http://influxdb:8086  # Docker-internal URL — used by Telegraf container
INFLUXDB_TOKEN=plantwise-dev-token
INFLUXDB_ORG=plantwise
INFLUXDB_BUCKET=sensors
